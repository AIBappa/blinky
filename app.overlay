&xiao_i2c {
    status = "okay"; 
    clock-frequency = <I2C_BITRATE_STANDARD>; 

    ads1115: ads1115@49 {
        compatible = "ti,ads1115";
        reg = <0x49>;
        #io-channel-cells = <1>;
        #address-cells = <1>;
        #size-cells = <0>;
    };
};

/ {
    chosen {
        zephyr,console = &board_cdc_acm_uart;
    };
};