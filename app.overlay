#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/* Forcefully redefine the I2C0 pin states for external headers */
&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
				    <NRF_PSEL(TWIM_SCL, 0, 5)>;
			bias-pull-up;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
				    <NRF_PSEL(TWIM_SCL, 0, 5)>;
			low-power-enable;
		};
	};
};

/* Disable the SPI peripheral that shares pins with i2c0 */
&spi0 {
    status = "disabled";
};

&i2c0 {
    compatible = "nordic,nrf-twim"; /* Force hardware DMA I2C driver */
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>; /* Force 100kHz standard mode */
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    ads1115: ads1115@48 {
        compatible = "ti,ads1115";
        reg = <0x48>;
        #io-channel-cells = <1>;
        #address-cells = <1>;
        #size-cells = <0>;

        /* Channel 0: Typical for Clinical Sensor Input */
        channel@0 {
            reg = <0>;
            zephyr,gain = "ADC_GAIN_1";      /* ±4.096V range */
            zephyr,reference = "ADC_REF_INTERNAL";
            zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
            zephyr,resolution = <15>;
        };

        /* Placeholder Channels 1-3 */
        channel@1 { reg = <1>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_INTERNAL"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <15>; };
        channel@2 { reg = <2>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_INTERNAL"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <15>; };
        channel@3 { reg = <3>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_INTERNAL"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <15>; };
    };
};

/ {
    /* This allows you to use 'DEVICE_DT_GET(DT_NODELABEL(ads1115))' in your C code */
    zephyr,user {
        io-channels = <&ads1115 0>;
    };
};