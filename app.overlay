&xiao_i2c {
    status = "okay"; 
    clock-frequency = <I2C_BITRATE_STANDARD>; 

    /* This creates the 'Sensor Doll' inside the 'I2C Doll' */
    ads1115: ads1115@48 {
        compatible = "ti,ads1115";
        reg = <0x48>;
        #io-channel-cells = <1>;
    };
};

/ {
    chosen {
        zephyr,console = &board_cdc_acm_uart; [cite: 2]
    };
};