/ {
    zephyr,user {
        /* DRDY is on D2 -> P0.28. Active Low. */
        drdy-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
    };
};

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,  /* XIAO D8  -> P1.13 */
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>, /* XIAO D10 -> P1.15 */
                    <NRF_PSEL(SPIM_MISO, 1, 14)>; /* XIAO D9  -> P1.14 */
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    
    /* CS is on D1 -> P0.03. Active Low. */
    cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>; 

    ads1220: ads1220@0 {
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <1000000>; /* Start at 1MHz for stability */
    };
};