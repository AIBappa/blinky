&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,   /* XIAO D8  -> P0.08 */
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>, /* XIAO D10 -> P0.10 */
                    <NRF_PSEL(SPIM_MISO, 0, 9)>;  /* XIAO D9  -> P0.09 */
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                    <NRF_PSEL(SPIM_MISO, 0, 9)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    
    /* CS is on D1 -> P0.26. Active Low. */
    cs-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>; 

    ads1220: ads1220@0 {
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <1000000>; /* Start at 1MHz for stability */
    };
};