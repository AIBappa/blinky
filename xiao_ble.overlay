&arduino_i2c {
    status = "okay";

    /* ADS1115 node at I2C address 0x48 */
    ads1115: ads1115@48 {
        compatible = "ti,ads1115";
        reg = <0x48>;
        #io-channel-cells = <1>;
        #address-cells = <1>;
        #size-cells = <0>;

        /* Default Channel 0 Setup */
        channel@0 {
            reg = <0>;
            zephyr,gain = "ADC_GAIN_1";      // Default Gain (±4.096V)
            zephyr,reference = "ADC_REF_INTERNAL";
            zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
            zephyr,resolution = <16>;
        };

        /* Add placeholders for other channels if needed */
        channel@1 { reg = <1>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_INTERNAL"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <16>; };
        channel@2 { reg = <2>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_INTERNAL"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <16>; };
        channel@3 { reg = <3>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_INTERNAL"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <16>; };
    };
};

/* Optional: Link the ADC to a 'zephyr,user' node for easier code access */
/ {
    zephyr,user {
        io-channels = <&ads1115 0>;
    };
};